import {
  "colmugx/acp",
  "colmugx/cetas-acp/lib",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/posoco-ext-mcp" @mcp,
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async",
}

supported_targets = "native"

// The session-lifetime (recovery) task group is a core-async one: posoco's
// quota guard and fuwaroid run on that stack.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/stdio",
  ],
)

pkgtype(kind: "executable")
