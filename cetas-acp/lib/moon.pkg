import {
  "colmugx/posoco",
  "colmugx/acp",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/mcp/transport",
  "posoco/devkit",
  "colmugx/posoco-ext-context" @context,
  "colmugx/posoco-ext-credentials" @credentials,
  "colmugx/posoco-ext-fs-session" @fs_session,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-ratelimit" @ratelimit,
  "colmugx/posoco-ext-workspace" @workspace,
  "colmugx/posoco/runtime",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/fs",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/async" @core_async,
  "colmugx/cetas-ext-forme/lib" @forme,
  "colmugx/posoco-ext-read" @read,
  "colmugx/posoco-ext-write" @write,
  "colmugx/posoco-ext-edit" @edit,
  "colmugx/posoco-ext-glob" @glob,
  "colmugx/posoco-ext-grep" @grep,
  "colmugx/posoco-ext-astgrep" @astgrep,
  "colmugx/posoco-ext-webfetch" @webfetch,
  "colmugx/posoco-ext-bash" @bash,
  "colmugx/posoco-ext-ps1" @ps1,
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-askquestion" @askquestion,
  "colmugx/posoco-ext-handoff" @handoff,
  "colmugx/posoco-ext-lazytools" @lazytools,
  "colmugx/posoco-ext-acp" @ext_acp,
  "colmugx/posoco-ext-mcp" @mcp,
  "colmugx/posoco-ext-plan" @plan,
  "colmugx/posoco-kit-lody" @lody_kit,
  "colmugx/posoco-kit-paseo" @paseo_kit,
}

import {
  "moonbitlang/async",
  "colmugx/posoco-ext-mcp" @mcp,
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-ratelimit" @ratelimit,
  "moonbitlang/core/json",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

supported_targets = "+native"

// The session-lifetime (recovery) task group is a core-async one: posoco's
// quota guard and fuwaroid run on that stack.

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
