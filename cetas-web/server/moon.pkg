import {
  "colmugx/cetas-console/console",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/async",
  "moonbitlang/core/async" @core_async,
  "moonbitlang/async/aqueue",
  "moonbitlang/async/websocket",
  "moonbitlang/moonback",
  "moonbitlang/moonback/middlewares/unstable_static",
}

supported_targets = "native"

pkgtype(kind: "executable")

// The session-lifetime (recovery) task group is a core-async one: posoco's
// quota guard and fuwaroid run on that stack.

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
