import {
  "colmugx/posoco",
  "colmugx/posoco-ext-bunraku" @bunraku,
  "colmugx/posoco/error",
  "colmugx/posoco/port",
  "colmugx/posoco/runtime",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/posoco-ext-profiles" @profiles,
  "posoco/devkit",
  "colmugx/posoco-ext-context" @context,
  "colmugx/posoco-ext-credentials" @credentials,
  "colmugx/posoco-ext-fs-session" @fs_session,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "colmugx/posoco-ext-openai" @openai,
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-ratelimit" @ratelimit,
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/debug",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/core/path",
  "colmugx/cetas-ext-forme/lib" @forme,
  "colmugx/cetas-extras/lib" @extras,
  "colmugx/posoco-ext-read" @read,
  "colmugx/posoco-ext-write" @write,
  "colmugx/posoco-ext-edit" @edit,
  "colmugx/posoco-ext-glob" @glob,
  "colmugx/posoco-ext-grep" @grep,
  "colmugx/posoco-ext-astgrep" @astgrep,
  "colmugx/posoco-ext-webfetch" @webfetch,
  "colmugx/posoco-ext-bash" @bash,
  "colmugx/posoco-ext-ps1" @ps1,
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-pstack" @pstack,
  "colmugx/posoco-ext-askquestion" @askquestion,
  "colmugx/posoco-ext-handoff" @handoff,
  "posoco/ext-herdr" @herdr,
  "colmugx/cetas-core/mcp_host",
  "colmugx/posoco-ext-magpie" @magpie,
  "colmugx/posoco-ext-mcp" @mcp,
  "colmugx/posoco-ext-plan" @plan,
  "colmugx/posoco-ext-pi-adaptor" @pi,
  "colmugx/posoco-ext-stats" @stats,
  "colmugx/posoco-ext-statusbar" @statusbar,
  "colmugx/posoco-ext-subagent" @subagent,
  "colmugx/posoco-ext-kind" @kind,
  "colmugx/posoco-kit-subagent" @subagent_kit,
  "posoco/kit-events" @kit_events,
  "moonbitlang/core/async",
  "colmugx/posoco-kit-model-management" @modelmgmt,
  "colmugx/posoco-ext-board" @board,
  "colmugx/posoco-ext-board/domain" @board_domain,
  "colmugx/posoco-ext-board/protocol" @board_protocol,
  "colmugx/posoco-ext-board/workflow" @board_workflow,
  "colmugx/posoco-ext-board/work_runtime" @work,
}

import {
  "colmugx/posoco/kernel",
  "colmugx/posoco/types" @posoco_types,
  "colmugx/posoco-ext-board/testkit/node_fs" @board_fixtures,
  "colmugx/posoco-ext-board/domain" @board_domain,
  "colmugx/posoco-ext-board/execution" @board_execution,
  "colmugx/posoco-ext-board/workflow" @board_workflow,
  "moonbitlang/core/async/aqueue",
  "posoco/devkit/testkit" @tk,
} for "wbtest"

// The session-lifetime (recovery) task group is a core-async one: posoco's
// quota guard and fuwaroid run on that stack.

supported_targets = "+js"

pkgtype(kind: "foreign_library")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/js_async",
  ],
  link: { "js": { "format": "esm" } },
)
