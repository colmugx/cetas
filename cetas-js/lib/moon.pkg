import {
  "colmugx/posoco",
  "colmugx/posoco/error",
  "colmugx/posoco/port",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/posoco-ext-fs-session" @fs_session,
  "moonbitlang/async",
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
}

warnings = "-unused_package"

options(
  supported_targets: "+js",
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "cetas_js_create_agent",
        "cetas_js_run_turn",
        "cetas_js_shutdown",
        "CetasJsConfig",
      ],
    },
  },
)
