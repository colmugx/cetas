import {
  "colmugx/posoco",
  "colmugx/posoco/error",
  "colmugx/posoco/port",
  "colmugx/posoco/runtime",
  "colmugx/cetas-core/lib" @cetas_core,
  "posoco/devkit",
  "colmugx/posoco-ext-context" @context,
  "colmugx/posoco-ext-credentials" @credentials,
  "colmugx/posoco-ext-fs-session" @fs_session,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "colmugx/posoco-ext-openai" @openai,
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-ratelimit" @ratelimit,
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/js_async",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  // recipe-imports:begin
  "colmugx/cetas-ext-forme/lib" @forme,
  "colmugx/posoco-ext-read" @read,
  "colmugx/posoco-ext-write" @write,
  "colmugx/posoco-ext-edit" @edit,
  "colmugx/posoco-ext-glob" @glob,
  "colmugx/posoco-ext-grep" @grep,
  "colmugx/posoco-ext-astgrep" @astgrep,
  "colmugx/posoco-ext-webfetch" @webfetch,
  "colmugx/posoco-ext-bash" @bash,
  "colmugx/posoco-ext-ps1" @ps1,
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-askquestion" @askquestion,
  "colmugx/posoco-ext-handoff" @handoff,
  "colmugx/posoco-ext-lazytools" @lazytools,
  "posoco/ext-herdr" @herdr,
  "colmugx/posoco-ext-mcp" @mcp,
  "colmugx/posoco-ext-plan" @plan,
  "colmugx/posoco-ext-pi-adaptor" @pi,
  "colmugx/posoco-ext-stats" @stats,
  "colmugx/posoco-ext-statusbar" @statusbar,
  "colmugx/posoco-ext-subagent" @subagent,
  "colmugx/posoco-ext-kind" @kind,
  "colmugx/posoco-kit-subagent" @subagent_kit,
  "colmugx/posoco-ext-nowledge-mem" @nmem,
  "colmugx/posoco-ext-obsidian" @obsidian,
  "colmugx/posoco-ext-zcode" @zcode,
  // recipe-imports:end
}

import {
  "colmugx/posoco/kernel",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
} for "wbtest"

warnings = "-unused_package"

options(
  supported_targets: "+js",
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "cetas_js_runtime_create_agent",
        "cetas_js_runtime_describe_setup",
        "cetas_js_runtime_refresh_model_catalogs",
        "cetas_js_runtime_refresh_model_lists_live",
        "cetas_js_runtime_login_provider",
        "cetas_js_run_turn",
        "cetas_js_run_turn_result",
        "cetas_js_resume_turn",
        "cetas_js_compact_session",
        "cetas_js_cancel_pending_ratelimit",
        "cetas_js_set_active_session",
        "cetas_js_abort_turn",
        "cetas_js_enqueue_follow_up",
        "cetas_js_rewind",
        "cetas_js_active_model_supports_images",
        "cetas_js_shutdown",
        "cetas_js_herdr_release",
        "cetas_js_list_commands",
        "cetas_js_tool_catalog",
        "cetas_js_pi_load_package",
        "cetas_js_pi_catalog_json",
        "cetas_js_invoke_command",
        "cetas_js_list_workspace_files",
        "cetas_js_sessions_dir",
        "cetas_js_session_titles",
        "CetasJsConfig",
        "CetasJsRuntime",
      ],
    },
  },
)
