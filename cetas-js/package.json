{
  "name": "@posoco/cetas",
  "version": "0.10.3",
  "private": true,
  "type": "module",
  "description": "Bun-runtime host for cetas — provider-neutral posoco agent with pi-tui",
  "scripts": {
    "start": "bun host.ts",
    "build": "bun build.ts",
    "build:macos": "bun build.ts darwin-arm64",
    "build:win": "bun build.ts windows-x64",
    "build:linux": "bun build.ts linux-x64",
    "build:linux-musl": "bun build.ts linux-x64-musl",
    "build:linux-arm64": "bun build.ts linux-arm64",
    "build:node": "bun build.ts --node-bundle",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./moonbit-preload.ts",
    "test:unit": "bun test-channels.ts unit",
    "test:e2e": "bun test-channels.ts e2e"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "latest",
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "bun-plugin-moonbit": "^0.1.0-beta.1",
    "estree-walker": "^3.0.3",
    "javascript-obfuscator": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^1.3.0",
    "chalk": "^6.0.0"
  }
}
