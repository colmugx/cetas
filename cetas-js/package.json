{
  "name": "cetas-js",
  "version": "0.1.1",
  "type": "module",
  "description": "Bun-runtime host for cetas — provider-neutral posoco agent with pi-tui",
  "scripts": {
    "start": "bun host.ts",
    "smoke": "bun smoke.ts",
    "build": "bun build.ts",
    "build:macos": "bun build.ts darwin-arm64",
    "build:win": "bun build.ts windows-x64",
    "build:linux": "bun build.ts linux-x64",
    "build:linux-musl": "bun build.ts linux-x64-musl",
    "build:linux-arm64": "bun build.ts linux-arm64",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "latest",
    "bun-plugin-moonbit": "^0.1.0-beta.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.3",
    "chalk": "^6.0.0"
  }
}
