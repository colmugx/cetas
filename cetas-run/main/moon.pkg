import {
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/cetas-run/lib",
  "colmugx/posoco",
  "moonbitlang/core/encoding/utf8",
  "colmugx/posoco-ext-permission" @permission,
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/async",
}

pkgtype(kind: "executable")

supported_targets = "+native +wasm"

// The session-lifetime (recovery) task group is a core-async one.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/stdio",
  ],
  targets: { "exit.native.mbt": [ "native" ], "exit.wasm.mbt": [ "wasm" ] },
)
