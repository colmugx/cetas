import {
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/cetas-run/lib",
  "colmugx/posoco",
  "colmugx/posoco-ext-permission" @permission,
  "moonbitlang/async",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

supported_targets = "+native +wasm"

options(
  targets: { "exit.native.mbt": [ "native" ], "exit.wasm.mbt": [ "wasm" ] },
)
