import {
  "colmugx/posoco",
  "colmugx/posoco/error",
  "colmugx/cetas-core/lib" @cetas_core,
  "posoco/devkit" @devkit,
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-workspace" @workspace,
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "colmugx/posoco-ext-credentials" @credentials,
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/fs",
  "moonbitlang/async/os_error",
  "moonbitlang/async/stdio",
  "moonbitlang/async/types",
  // recipe-imports:begin
  "colmugx/cetas-ext-forme/lib" @forme,
  "colmugx/posoco-ext-read" @read,
  "colmugx/posoco-ext-write" @write,
  "colmugx/posoco-ext-edit" @edit,
  "colmugx/posoco-ext-glob" @glob,
  "colmugx/posoco-ext-grep" @grep,
  "colmugx/posoco-ext-astgrep" @astgrep,
  "colmugx/posoco-ext-webfetch" @webfetch,
  "colmugx/posoco-ext-bash" @bash,
  "colmugx/posoco-ext-ps1" @ps1,
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-askquestion" @askquestion,
  "colmugx/posoco-ext-handoff" @handoff,
  "colmugx/posoco-ext-lazytools" @lazytools,
  "posoco/ext-herdr" @herdr,
  // recipe-imports:end
}

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
} for "wbtest"

supported_targets = "+native +wasm"

options(
  "native-stub": [ "terminal_auth_stub.c" ],
  targets: {
    "terminal_auth.native.mbt": [ "native" ],
    "terminal_auth_native_wbtest.mbt": [ "native" ],
    "login_native.mbt": [ "native" ],
    "login_wasm.mbt": [ "wasm" ],
    "login_wbtest.mbt": [ "native" ],
    "login_driver_wbtest.mbt": [ "native" ],
    "login_storage_wbtest.mbt": [ "native" ],
  },
)
