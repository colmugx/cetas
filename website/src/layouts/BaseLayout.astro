---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/globals.css";
import "../styles/prose.css";
import { ClientRouter } from "astro:transitions";
import { build, trailingSlash } from "astro:config/client";
import { config } from "virtual:nimbus/config";
import {
  getCollectionLlmsUrl,
  getVersionStatus,
  stripBase,
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import AgentDirective from "@/components/AgentDirective.astro";
import SoftwareApplicationJsonLd from "@/components/SoftwareApplicationJsonLd.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import WebMCP from "@/components/WebMCP.astro";
import type { BasePageProps, HeadElement } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps;

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  apiVersion,
  coordinate,
} = Astro.props;

const lang =
  collection === "en" ? "en" : (config.locale ?? "zh-CN");
// Per-page agent-index pointer. For pages in non-primary or version
// collections, this resolves to `/<prefix>/llms.txt` (e.g. `/v0/llms.txt`
// for a v0 docs page, `/blog/llms.txt` for a blog post). Falls back to
// the root `/llms.txt` when no collection is provided.
// Hidden-version pages don't advertise an agent index (the per-version
// llms.txt isn't emitted for them); suppress the AgentDirective entirely.
const versionStatusKey =
  apiVersion && collection ? `${collection}@${apiVersion}` : collection;
const versionStatus = versionStatusKey
  ? await getVersionStatus(versionStatusKey)
  : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = collection
  ? await getCollectionLlmsUrl(collection)
  : "/llms.txt";
const baseUrl = import.meta.env.BASE_URL;
const basedLlmsUrl = withBase(llmsIndexPath, baseUrl);
const llmsUrl = Astro.site
  ? new URL(basedLlmsUrl, Astro.site).href
  : basedLlmsUrl;
// Homepage-only scope for the SoftwareApplication JSON-LD: the zh home
// renders at the base root and the en home at `<base>en/` — the two pages
// Home.astro renders. Same shape-matching NimbusHead uses for `isHomePage`;
// the trailing-slash strip turns the root into `""` and leaves `/en`.
const barePath = stripBase(Astro.url.pathname, baseUrl)
  .replace(/(?:\/index)?\.html$/, "")
  .replace(/\/+$/, "");
const isHomePage = barePath === "" || barePath === "/en";
// zh/en hreflang alternates — the head-level language signals for the
// zh ↔ /en/ mirror. NimbusHead already emits the canonical plus the
// markdown/llms `rel="alternate"` links but no hreflang, so this supplies
// exactly the missing family: every page in the mirror declares the full
// cluster — hreflang="zh-CN" and hreflang="en" pointing at each other via
// the same prefix swap LanguageSwitch uses, plus hreflang="x-default"
// pointing at the zh URL. Rendered through NimbusHead's `head` channel, so
// the tags stay centralized here and nothing is emitted twice.
//
// Scope: only pages of the two mirrored collections (docs entries, home,
// changelog — they all arrive with `collection` set). The 404 page passes
// no collection and its prefix-swapped counterpart (/en/404/) doesn't
// exist, so the gate keeps it out. Pages that aren't crawlable get no
// cluster either: hreflang is an indexing signal, and emitting it from a
// page whose robots meta says noindex (or from a hidden version) would be
// a self-contradictory pair of signals.
const MIRRORED_COLLECTIONS = new Set(["docs", "en"]);
const site = Astro.site;
const hreflangHead: HeadElement[] = [];
if (
  collection &&
  MIRRORED_COLLECTIONS.has(collection) &&
  site &&
  !(noindex || isHiddenVersion)
) {
  // Same trailing-slash rule NimbusHead applies to the canonical, so the
  // alternate URLs and the canonical always share one site-wide policy.
  const appendsSlash =
    trailingSlash === "always" ||
    (trailingSlash === "ignore" && build.format === "directory");
  const slash = (path: string) =>
    path === "" ? "/" : appendsSlash ? `${path}/` : path;
  const isEnPath = barePath === "/en" || barePath.startsWith("/en/");
  const rest = isEnPath ? barePath.slice("/en".length) : barePath;
  const absolute = (path: string) => new URL(withBase(path, baseUrl), site).href;
  const zhUrl = absolute(slash(rest));
  const enUrl = absolute(slash(`/en${rest}`));
  hreflangHead.push(
    { tag: "link", attrs: { rel: "alternate", hreflang: "zh-CN", href: zhUrl } },
    { tag: "link", attrs: { rel: "alternate", hreflang: "en", href: enUrl } },
    { tag: "link", attrs: { rel: "alternate", hreflang: "x-default", href: zhUrl } },
  );
}
const basedMarkdownUrl = markdownUrl ? withBase(markdownUrl, baseUrl) : undefined;
const resolvedMarkdownUrl =
  basedMarkdownUrl && Astro.site
    ? new URL(basedMarkdownUrl, Astro.site).href
    : basedMarkdownUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <WebMCP />

    <script is:inline>
      (() => {
        const KEY = "ui-mode";
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPref = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" ? v : null;
          } catch {
            return null;
          }
        };

        const resolveMode = () => readPref() ?? (media.matches ? "dark" : "light");

        const applyTheme = () => {
          const root = document.documentElement;
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        window.__nbApplyTheme = applyTheme;
      })();
    </script>

    <NimbusHead
      title={title}
      description={description}
      noindex={noindex}
      markdownUrl={markdownUrl}
      socialImage={socialImage}
      lastUpdated={lastUpdated}
      head={[...hreflangHead, ...pageHead]}
      collection={collection}
      entryId={entryId}
      apiVersion={apiVersion}
      coordinate={coordinate}
    />
    {isHomePage && (
      <SoftwareApplicationJsonLd
        title={title}
        description={description}
        noindex={noindex || isHiddenVersion}
      />
    )}
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground focus:no-underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
    >
      Skip to content
    </a>
    {!isHiddenVersion && (
      <AgentDirective markdownUrl={resolvedMarkdownUrl ?? null} llmsUrl={llmsUrl} />
    )}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
  </body>
</html>
