---
/**
 * SoftwareApplication JSON-LD for the homepages — the single injection
 * channel for the rich-result markup.
 *
 * Scope: `/` (zh) and `/en/` (en), both rendered by Home.astro. The block
 * only states what the page (or a page it links) already shows: name is
 * the page H1 (`copy.title`), description is the visible lead sentence for
 * the current language, codeRepository is the nimbus config's `github`.
 * Nothing is invented for rich results: no `offers` price for free
 * open-source software (`isAccessibleForFree` carries that), no
 * `aggregateRating` (no rating data exists). `operatingSystem` carries the
 * platform matrix the installation page documents
 * ("macOS · Apple Silicon / Linux · x64 / Windows · x64") — it is also
 * load-bearing: Google's software-app rule errors unless at least two of
 * {offers, aggregateRating, applicationCategory, operatingSystem} are
 * present, and those other two are excluded by the no-fabrication
 * constraints above.
 *
 * Shared gates, so every caller inherits them:
 *   - `noindex` (or a hidden-version page, merged by BaseLayout) emits
 *     nothing — rich-result markup never ships on non-crawlable pages;
 *   - a missing `config.github` fails the build loudly instead of emitting
 *     a half-sourced node.
 *
 * NimbusHead keeps emitting its own `WebSite` JSON-LD; this block coexists
 * as a second script tag and NimbusHead itself is never touched (an
 * upgrade would wipe hand edits there).
 */
import { config } from "virtual:nimbus/config";

interface Props {
  /** Page H1 — the homepage's `copy.title` ("Cetas" in every language). */
  title: string;
  /** Visible lead sentence — the homepage's `copy.description`. */
  description?: string;
  /** Shared noindex gate: true suppresses the markup entirely. */
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;

let structuredData: string | null = null;
if (!noindex) {
  const repository = config.github;
  if (!repository) {
    throw new Error(
      "SoftwareApplicationJsonLd: `github` is not set in the nimbus config — refusing to emit a SoftwareApplication JSON-LD without a sourced codeRepository.",
    );
  }
  structuredData = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: title,
    ...(description ? { description } : {}),
    applicationCategory: "DeveloperApplication",
    // The platform matrix the installation page (linked from the homepage)
    // documents: macOS · Apple Silicon / Linux · x64 / Windows · x64.
    operatingSystem: "macOS, Linux, Windows",
    // Free and open source: the repo's LICENSE and the free
    // `npm install -g` line on the page are the visible source. Expressed
    // without a fabricated `offers` price.
    isAccessibleForFree: true,
    codeRepository: repository,
  });
}
---

{structuredData && <script type="application/ld+json" set:html={structuredData} />}
