---
/**
 * English docs route — the `/en` mirror of `src/pages/[...slug].astro`.
 *
 * The primary `docs` collection owns the root paths (Chinese, the default), so
 * English lives in its own `en` collection, which Nimbus mounts at `/en` from
 * the collection name. Slugs are identical across both, which is what makes
 * the header language switch a prefix swap.
 */
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  getCollectionStaticPaths,
  getCollectionPageProps,
  getRouteFlags,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
  stripBase,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../../components";
import { sidebarForCollection } from "../../lib/sidebar-for-collection";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("en");

const page = await getCollectionPageProps<"en">(Astro);
const { entry, Content, headings, markdownUrl, ogImageUrl } = page;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const sidebar = sidebarOn
  ? await sidebarForCollection(entry.collection, currentSlug)
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const socialImage = entry.data.socialImage ?? ogImageUrl;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
