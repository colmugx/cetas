import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/cetas-console/console",
  "colmugx/posoco",
  "colmugx/posoco-ext-workspace" @workspace,
  "colmugx/posoco-ext-permission" @permission,
  "posoco/ext-llm" @ext_llm,
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
