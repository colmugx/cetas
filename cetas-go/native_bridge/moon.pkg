import {
  "colmugx/cetas-console/console",
  "colmugx/cetas-core/lib" @cetas_core,
  "colmugx/posoco",
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-workspace" @workspace,
  "moonbitlang/core/async" @core_async,
  "moonbitlang/core/async/raw_fd",
  "moonbitlang/core/async/types",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

// Fd is only referenced by the POSIX-native bridge implementation.
// moon.pkg #cfg only accepts backend targets (native/js/wasm), not OS
// platforms, so the import is necessarily unused on Windows.
// Keep all other compiler diagnostics enabled.
warnings = "-unused_package"

supported_targets = "native"

pkgtype(kind: "foreign_library")

options(
  "native-stub": [ "test_symbols.c" ],
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/raw_fd",
    "moonbitlang/core/async/types",
  ],
)
