import {
  "colmugx/posoco",
  "posoco/ext-oauth" @oauth,
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/types",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+native +wasm"

options(
  "native-stub": [ "terminal_auth_stub.c" ],
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/types",
    "moonbitlang/core/async/stdio",
  ],
  targets: {
    "terminal_auth.native.mbt": [ "native" ],
    "terminal_auth_native_wbtest.mbt": [ "native" ],
  },
)
