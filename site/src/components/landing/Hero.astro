---
import TerminalDemo from '../interactive/TerminalDemo';
---
<section class="hero">
  <div class="site-container hero-grid">
    <div>
      <div class="hero-brandline" aria-hidden="true">
        <img src="/assets/cetas-logo-96.png" alt="" width="42" height="42" />
        <span>CETAS // 0x01</span>
      </div>
      <div class="eyebrow">Open-source coding agent</div>
      <h1>One agent.<br/><span>Every surface.</span></h1>
      <p class="hero-copy">Work with Cetas from the terminal, your editor through ACP, or a headless process. Different ways in, one Cetas underneath.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/docs/getting-started/">Get started →</a>
        <a class="button button-secondary" href="https://github.com/colmugx/cetas">GitHub ↗</a>
      </div>
      <div class="hero-meta"><span>v0.3.2</span><span>Apache-2.0</span><span>Open source</span></div>
    </div>
    <TerminalDemo client:visible />
  </div>
</section>
