---
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import '../styles/global.css';
import '../styles/landing.css';
import '../styles/retro.css';
interface Props { title?: string; description?: string; }
const { title='Cetas — One agent. Every surface.', description='Cetas is one coding agent across terminal, editor/ACP, and headless surfaces.' }=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#f8f4ec"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta name="twitter:card" content="summary"/><link rel="icon" href="/assets/cetas-logo.png" type="image/png"/><link rel="apple-touch-icon" href="/assets/cetas-logo.png"/><title>{title}</title><script is:inline>(()=>{const stored=localStorage.getItem('cetas-theme');if(stored==='light'||stored==='dark')document.documentElement.dataset.theme=stored;else if(window.matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.dataset.theme='dark'})()</script></head><body><div class="marketing-shell"><Header /><slot /><Footer /></div></body></html>
