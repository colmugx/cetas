fn compiled_nmem_enabled() -> Bool {
  @env.get_env_var("CETAS_NMEM") == Some("1")
}

///|
fn compiled_obsidian_enabled() -> Bool {
  match @env.get_env_var("CETAS_OBSIDIAN") {
    Some(value) => value != "off"
    None => false
  }
}

