import {
  "colmugx/posoco",
  "colmugx/posoco-devkit" @devkit,
  "colmugx/cetas-ext-forme/lib" @forme,
  "colmugx/posoco-ext-read" @read,
  "colmugx/posoco-ext-write" @write,
  "colmugx/posoco-ext-edit" @edit,
  "colmugx/posoco-ext-bash" @bash,
  "colmugx/posoco-ext-ps1" @ps1,
  "colmugx/posoco-ext-glob" @glob,
  "colmugx/posoco-ext-grep" @grep,
  "colmugx/posoco-ext-webfetch" @webfetch,
  "colmugx/posoco-ext-llm" @llm,
  "colmugx/posoco-ext-oauth" @oauth,
  "colmugx/posoco-ext-deepseek" @deepseek,
  "colmugx/posoco-ext-kimi" @kimi,
  "colmugx/posoco-ext-openai" @openai,
  "colmugx/posoco-ext-openai-compatible" @openai_compatible,
  "colmugx/posoco-ext-opencode-zen" @opencode_zen,
  "colmugx/posoco-ext-zai" @zai,
  "colmugx/posoco-ext-zai-coding-plan" @zai_coding_plan,
  "colmugx/posoco-ext-openrouter" @openrouter,
  "colmugx/posoco-ext-workspace" @workspace,
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-nowledge-mem" @nmem,
  "colmugx/posoco-ext-herdr" @herdr,
  "colmugx/posoco-ext-askquestion" @askquestion,
  "colmugx/posoco-ext-rtk" @rtk,
  "colmugx/posoco-ext-handoff" @handoff,
  "colmugx/posoco-ext-obsidian" @obsidian,
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/async",
}

import {
  "moonbitlang/async",
} for "wbtest"

warnings = "-unused_package"

// nowledge-mem (js+native only) caps this package to js+native, so moon
// info's wasm backend can never regenerate an interface snapshot — the
// nowledge-mem/plan/mcp precedent: restricted-target packages carry no
// pkg.generated.mbti.

supported_targets = "+native +js"

// Bakes the shell-ext platform choice at compile time: sh lib/platform_gen.sh
// (cwd is the module root) regenerates platform_gen.mbt from the
// platform_target knob (windows|unix|auto). The knob file is the rule input,
// so every change re-triggers generation; the committed defaults ("auto") keep
// builds where this author-side rule does not fire (published-package
// consumers) on runtime platform detection.
rule(name: "gen_platform", command: "sh lib/platform_gen.sh")

dev_build(
  rule: "gen_platform",
  input: "platform_target",
  output: "platform_gen.mbt",
)

// Bakes the Nowledge Mem opt-in at compile time: sh lib/nmem_gen.sh
// regenerates nmem_gen.mbt from the nmem_target knob (on|off|auto). "on" is
// the personal build, "off" the public release, "auto" the committed default
// that keeps a CETAS_NMEM runtime fallback for plain dev builds. The knob file
// is the rule input for the same cache reason as gen_platform.
rule(name: "gen_nmem", command: "sh lib/nmem_gen.sh")

dev_build(rule: "gen_nmem", input: "nmem_target", output: "nmem_gen.mbt")
