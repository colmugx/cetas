import {
  "colmugx/posoco",
  "colmugx/posoco-ext-profiles" @profiles,
  "posoco/devkit",
  "posoco/ext-llm" @llm,
  "posoco/ext-oauth" @oauth,
  "colmugx/posoco-ext-deepseek" @deepseek,
  "colmugx/posoco-ext-typesafe" @typesafe,
  "colmugx/posoco-ext-kimi" @kimi,
  "colmugx/posoco-ext-openai" @openai,
  "colmugx/posoco-ext-custom" @custom,
  "colmugx/posoco-ext-opencode-zen" @opencode_zen,
  "colmugx/posoco-ext-opencode-go" @opencode_go,
  "colmugx/posoco-ext-zai" @zai,
  "colmugx/posoco-ext-zai-coding-plan" @zai_coding_plan,
  "colmugx/posoco-ext-openrouter" @openrouter,
  "colmugx/posoco-ext-workspace" @workspace,
  "colmugx/posoco-ext-context" @context,
  "colmugx/posoco-ext-credentials" @credentials,
  "colmugx/posoco-ext-fs-session" @fs_session,
  "colmugx/posoco-ext-permission" @permission,
  "colmugx/posoco-ext-ratelimit" @ratelimit,
  "colmugx/posoco/runtime",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/async",
}

import {
  "colmugx/posoco-ext-fs-session" @fs_session,
  "colmugx/posoco-ext-workspace" @workspace,
  "posoco/devkit/testkit" @tk,
} for "wbtest"

supported_targets = "+native +js +wasm"

// The rate-limit guard and its recovery runtime (posoco) live on the
// experimental core-async stack; the host hands `compose_cetas_agent` a
// `moonbitlang/core/async` task group for the session lifetime.

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
