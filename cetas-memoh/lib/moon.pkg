import {
  "colmugx/posoco",
  "colmugx/acp",
  "posoco/devkit",
  "colmugx/posoco-ext-acp" @ext_acp,
  "colmugx/posoco-ext-memoh" @memoh,
  "colmugx/posoco-ext-mcp" @mcp,
  "posoco/ext-llm" @llm,
  "colmugx/posoco-ext-credentials" @credentials,
  "posoco/ext-oauth" @oauth,
  "colmugx/posoco-ext-workspace" @workspace,
  "colmugx/posoco-ext-skills" @skills,
  "colmugx/posoco-ext-askquestion" @askquestion,
  "colmugx/posoco-ext-lazytools" @lazytools,
  "colmugx/posoco-ext-deepseek" @deepseek,
  "colmugx/posoco-ext-kimi" @kimi,
  "colmugx/posoco-ext-openai" @openai,
  "colmugx/posoco-ext-custom" @custom,
  "colmugx/posoco-ext-opencode-zen" @opencode_zen,
  "colmugx/posoco-ext-openrouter" @openrouter,
  "colmugx/posoco-ext-zai" @zai,
  "colmugx/posoco-ext-zai-coding-plan" @zai_coding_plan,
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/types",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

supported_targets = "+native"

options(
  "native-stub": [ "terminal_setup_stub.c" ],
  // The ACP prompt pump runs on posoco's core-async stack.
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/stdio",
    "moonbitlang/core/async/types",
  ],
  targets: {
    "terminal_setup.native.mbt": [ "native" ],
    "setup.native.mbt": [ "native" ],
  },
)
